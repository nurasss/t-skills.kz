{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbita-30",
  "main": "dist/server/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": false },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "orbita-30-staging",
      "vars": {
        "APP_ENV": "staging",
        "ORBITA_ENV": "staging",
        "APP_BASE_URL": "https://orbita-30-staging.bulatulynurasyl22.workers.dev",
        "PUBLIC_INDEXING_ENABLED": "false",
        "AUTH_PROVIDER": "app-password",
        "REGISTRATION_MODE": "hybrid",
        "PUBLIC_SIGNUP_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "ENTITLEMENT_MODE": "beta-free",
        "AI_ENABLED": "true",
        "ADAPTIVE_PROVIDER": "mercury",
        "MERCURY_MODEL": "mercury-2.5",
        "MERCURY_TIMEOUT_MS": "12000",
        "MERCURY_MAX_RETRIES": "2",
        "REPORT_PROVIDER": "approved-library",
        "RETENTION_DRY_RUN": "true"
      },
      "secrets": { "required": ["INCEPTION_API_KEY", "RESEND_API_KEY", "AUTH_RATE_LIMIT_SECRET", "PDF_SIGNING_SECRET", "ORBITA_INTERNAL_TOKEN"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "orbita30-staging",
        "database_id": "7b422314-c2a5-424a-8b66-464f9e63e02e",
        "migrations_dir": "drizzle"
      }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "orbita30-staging" }],
      "triggers": { "crons": ["0 2 * * *"] }
    },
    "production": {
      "name": "orbita-30-production",
      "vars": {
        "APP_ENV": "production-beta",
        "ORBITA_ENV": "production",
        "AUTH_PROVIDER": "app-password",
        "REGISTRATION_MODE": "hybrid",
        "PUBLIC_SIGNUP_ENABLED": "false",
        "APP_BASE_URL": "https://orbita-30.yzh905284.chatgpt.site",
        "PUBLIC_INDEXING_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "ENTITLEMENT_MODE": "beta-free",
        "AI_ENABLED": "false",
        "ADAPTIVE_PROVIDER": "deterministic",
        "MERCURY_MODEL": "mercury-2.5",
        "MERCURY_TIMEOUT_MS": "12000",
        "MERCURY_MAX_RETRIES": "2",
        "REPORT_PROVIDER": "approved-library",
        "RETENTION_DRY_RUN": "true"
      },
      "secrets": { "required": ["RESEND_API_KEY", "AUTH_RATE_LIMIT_SECRET", "PDF_SIGNING_SECRET", "ORBITA_INTERNAL_TOKEN"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "orbita30-production",
        "database_id": "17655eda-ebd5-407d-a127-df1ad62fead5",
        "migrations_dir": "drizzle"
      }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "orbita30-production" }],
      "triggers": { "crons": ["0 2 * * *"] }
    }
  }
}
