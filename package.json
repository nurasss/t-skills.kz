{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.13.x"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "c8 --all --include='lib/**/*.ts' --reporter=text --reporter=json-summary tsx --test tests/*.test.ts && node scripts/check-coverage.mjs",
    "test:properties": "tsx --test tests/property.test.ts",
    "test:faults": "tsx --test tests/fault-injection.test.ts",
    "test:load": "node scripts/load-smoke.mjs",
    "test:browser": "playwright test tests/browser/csp.spec.ts",
    "test:pdf-visual": "node --import tsx --loader ./scripts/ttf-inline-loader.mjs scripts/pdf-visual-fixtures.ts && node scripts/pdf-visual-qa.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:beta": "node scripts/beta-smoke.mjs",
    "test:backup": "node scripts/backup-restore-smoke.mjs",
    "test:retention-plan": "node scripts/retention-query-plan.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "check:gates": "node scripts/check-release-gates.mjs",
    "deploy:config-check": "node scripts/validate-deployment-config.mjs",
    "package:source": "node scripts/package-source.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "ci:verify": "npm run lint && npm run security:scan && npx tsc --noEmit && npm test && npm run test:coverage && npm run build && npm run db:check && npm run test:retention-plan && npm run test:browser",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migration-drift.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@hookform/resolvers": "^5.7.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "c8": "^12.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
