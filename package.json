{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.13.x"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:vercel": "ORBITA_DEPLOY_TARGET=vercel NITRO_PRESET=vercel vite build",
    "build:vps": "ORBITA_DEPLOY_TARGET=node NITRO_PRESET=node-server vite build",
    "start:vps": "node .output/server/index.mjs",
    "db:migrate:vps": "node scripts/migrate-sqlite.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .output --ignore-pattern 'brag-output-*'",
    "dead-code": "knip --no-progress",
    "unused-deps": "depcheck --ignores=\"tsx,c8,wrangler,nitro,vinext,vite,@cloudflare/vite-plugin,@vitejs/plugin-react,@vitejs/plugin-rsc,react-server-dom-webpack,next,eslint,eslint-config-next,typescript,@types/*,@playwright/test,fast-check,drizzle-kit,drizzle-orm,@tailwindcss/postcss,tailwindcss,cloudflare:workers\"",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "prompts:check": "node scripts/validate-prompts.mjs",
    "content:t-skills:check": "tsx scripts/validate-t-skills-content.ts",
    "content:t-skills:v5:check": "tsx scripts/validate-t-skills-v5-content.ts",
    "content:t-skills:v5:import": "tsx scripts/import-t-skills-v5-content.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --no-warnings --import tsx/esm --import ./tests/helpers/cf-register.mjs --loader ./scripts/ttf-inline-loader.mjs --test tests/integration/*.test.ts",
    "test:coverage": "c8 --all --include='lib/**/*.ts' --reporter=text --reporter=json-summary tsx --test tests/*.test.ts && node scripts/check-coverage.mjs",
    "test:properties": "tsx --test tests/property.test.ts",
    "test:faults": "tsx --test tests/fault-injection.test.ts",
    "test:load": "node scripts/load-smoke.mjs",
    "test:browser": "playwright test tests/browser/csp.spec.ts",
    "test:pdf-visual": "node --import tsx --loader ./scripts/ttf-inline-loader.mjs scripts/pdf-visual-fixtures.ts && node scripts/pdf-visual-qa.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:beta": "node scripts/beta-smoke.mjs",
    "test:backup": "node scripts/backup-restore-smoke.mjs",
    "test:retention-plan": "node scripts/retention-query-plan.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "audit:check": "npm audit --audit-level=moderate",
    "check:gates": "node scripts/check-release-gates.mjs",
    "deploy:config-check": "node scripts/validate-deployment-config.mjs",
    "package:source": "node scripts/package-source.mjs",
    "package:source:check": "node scripts/check-source-package.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "ci:verify": "npm run lint && npm run security:scan && npm run audit:check && npm run csp:check && npm run contrast:check && npm run prompts:check && npm run unused-deps && npm run dead-code && npm run bundle:check && npx tsc --noEmit && npm test && npm run test:coverage && npm run build && npm run db:check && npm run test:retention-plan && npm run test:browser && npm run package:source:check",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migration-drift.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "c8": "^12.0.0",
    "depcheck": "^1.4.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "knip": "^6.36.0",
    "nitro": "3.0.260903-beta",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.0",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module"
}
