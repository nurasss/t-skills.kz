# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# PDF visual regression renders are disposable test output.
/tmp/
# Playwright traces and attachments are disposable test output.
/test-results/

# next.js
/.next/
/.vinext/
/.vite/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
# Nitro node-server (VPS) build output.
.output/
# Temporary VPS build contexts and deployment artifacts.
/.deploy/
# VPS runtime state: SQLite database and file bucket live here.
/data/
*.db
*.db-wal
*.db-shm
*.tsbuildinfo
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
# Reproducibility artifacts are created outside the checkout by default.
*.source.tar.gz
# Keep the release package available locally for handoff without publishing it
# as part of the Git source tree or accidentally including it in a source pack.
/release-artifacts/
# Local hosted smoke output is captured separately in deployment evidence.
/hosted-smoke-*.json
.eslintcache
/output/
/brag-output-*/
Thumbs.db
*.log
