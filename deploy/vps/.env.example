# VPS environment for T-Skills (deploy/vps/.env — never commit the real one).
# Start from the root .env.example for application values, then add/override:
#
# --- storage (must match docker-compose volumes) ---
# SQLITE_DB_PATH=/data/app.db
# VPS_FILE_DIR=/data/files
#
# --- networking ---
# TRUST_PROXY=true
# PORT=3000
# APP_BASE_URL=https://t-skills.kz
# PUBLIC_INDEXING_ENABLED=false
#
# --- required secrets (generate with: openssl rand -hex 32) ---
# AUTH_RATE_LIMIT_SECRET=
# PDF_SIGNING_SECRET=
# ORBITA_INTERNAL_TOKEN=
# AUTH provider: app-password is the only supported VPS mode.
# AUTH_PROVIDER=app-password
# REGISTRATION_MODE=invite
# PUBLIC_SIGNUP_ENABLED=false
#
# --- email (Resend; sender domain must be verified in Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM=T-Skills <noreply@t-skills.kz>
# EMAIL_REPLY_TO=
#
# --- payments (leave disabled until Stripe live is approved) ---
# PAYMENTS_ENABLED=false
# ENTITLEMENT_MODE=beta-free
# ASSESSMENT_PRICE_MINOR=
# ASSESSMENT_CURRENCY=KZT
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# --- adaptive/report providers ---
# AI_ENABLED=false
# ADAPTIVE_PROVIDER=deterministic
# REPORT_PROVIDER=approved-library
# OPENAI_API_KEY= (only as an explicit opt-in, never in git)
#
# --- retention cron (host crontab, runs the in-app sweep) ---
# 0 2 * * * /usr/bin/curl -sf -X POST https://t-skills.kz/internal/retention \
#   -H "X-Internal-Token: ${ORBITA_INTERNAL_TOKEN}" \
#   -H 'Content-Type: application/json' -d '{"dry_run":false,"limit":500}' >> /var/log/t-skills-retention.log 2>&1
#
# --- legal/operator placeholders: fill every one before public launch ---
# SUPPORT_CONTACT=
# LEGAL_ENTITY_NAME=
# LEGAL_CONTACT_ADDRESS=
# LEGAL_CONTACT_PHONE=
# LEGAL_JURISDICTION=
