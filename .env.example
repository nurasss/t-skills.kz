ORBITA_ENV=development
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8787
PUBLIC_INDEXING_ENABLED=false
AUTH_PROVIDER=app-password
REGISTRATION_MODE=hybrid
PUBLIC_SIGNUP_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=T-Skills <noreply@example.com>
EMAIL_REPLY_TO=
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_RATE_LIMIT_SECRET=

PAYMENTS_ENABLED=false
ENTITLEMENT_MODE=beta-free
PAYMENT_PROVIDER=stripe
ASSESSMENT_CURRENCY=KZT
# Minor units: 1500 KZT = 150000
ASSESSMENT_PRICE_MINOR=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# approved-library is deterministic and requires no external API.
AI_ENABLED=false
REPORT_PROVIDER=approved-library
REPORT_MODEL=gpt-5
REPORT_TIMEOUT_MS=20000
PDF_SIGNING_SECRET=
ADAPTIVE_PROVIDER=deterministic
ADAPTIVE_MODEL=gpt-5
ADAPTIVE_TIMEOUT_MS=10000
# v2 Mercury adaptive generation. Keep the key in the managed secret store;
# this placeholder is never bundled or sent to the browser.
INCEPTION_API_KEY=
MERCURY_MODEL=mercury-2.5
MERCURY_TIMEOUT_MS=12000
MERCURY_MAX_RETRIES=2
# Optional: store the real key only in the Sites/Cloudflare managed secret store.
# It is never sent to the browser or included in telemetry. Missing/error/timeout
# always falls back to the approved v2 fallback bank/deterministic behavior.
# OPENAI_API_KEY is intentionally omitted from this example; configure it only
# as a managed secret when the optional OpenAI provider is explicitly enabled.
OPENAI_BASE_URL=https://api.openai.com

RETENTION_DAYS=365
RETENTION_DRY_RUN=true
ORBITA_ADMIN_USER_IDS=
ORBITA_INTERNAL_TOKEN=
SECURITY_CONTACT_EMAIL=

# Public support/legal configuration. Replace every placeholder before launch.
SUPPORT_CONTACT=
LEGAL_CONTACT_ADDRESS=
LEGAL_CONTACT_PHONE=
LEGAL_ENTITY_NAME=
LEGAL_JURISDICTION=
LEGAL_PROCESSING_PURPOSES=
LEGAL_DATA_CATEGORIES=
LEGAL_RETENTION_SCHEDULE=
LEGAL_PROCESSORS=
LEGAL_CROSS_BORDER_PROCESSING=
LEGAL_USER_RIGHTS=
LEGAL_SECURITY_SUMMARY=
LEGAL_RESEARCH_POLICY=
LEGAL_MARKETING_POLICY=
LEGAL_REFUND_POLICY=
LEGAL_COOKIE_POLICY=

# --- VPS (Node) target only: SQLite file + local file bucket + trusted proxy ---
# Ignored on Cloudflare (D1/R2 bindings win when present).
# SQLITE_DB_PATH=./data/app.db
# VPS_FILE_DIR=./data/files
# TRUST_PROXY=false
